{
  "name": "Bar",
  "emoji": "🍸",
  "rules": {
    "chat": [
      { "match": "^!nhac\\s+(.{1,60})$", "action": "request_song", "priority": 2, "minTier": "regular", "say": "{name} chọn bài {text}" },
      { "action": "chat" }
    ],
    "gift": [
      { "minCoins": 1, "action": "gift_small", "priority": 1, "say": "Một ly Mojito cho {name}!", "params": { "emoji": "🍹", "label": "🍹 Mojito" } },
      { "minCoins": 30, "action": "gift_medium", "priority": 2, "say": "Cảm ơn {name}! Lên sàn nào!", "params": { "emoji": "🍸", "label": "🍸 Cocktail" } },
      { "minCoins": 500, "action": "gift_big", "priority": 3, "say": "Phục vụ bàn VIP cho {name}!", "params": { "emoji": "🍾", "label": "🍾 Bàn VIP" } },
      { "minCoins": 5000, "action": "gift_huge", "priority": 4, "say": "{name} mời cả quán! Cảm ơn {name}!", "params": { "emoji": "🥂", "label": "🥂 Mời cả quán" } }
    ]
  }
}
