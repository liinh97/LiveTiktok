{
  "_ghi_chu": "commands: mỗi loại quà rẻ là một lệnh (khớp theo TÊN quà TikTok; tên/giá quà có thể khác theo khu vực, sửa ở đây cho đúng). Quà không có trong commands thì tính theo bậc xu ở gift.",
  "name": "Bar",
  "emoji": "🍸",
  "rules": {
    "chat": [
      {
        "match": "^!nhac\\s+(.{1,60})$",
        "action": "request_song",
        "priority": 2,
        "minTier": "regular",
        "say": "{name} chọn bài {text}"
      },
      {
        "action": "chat"
      }
    ],
    "gift": [
      {
        "minCoins": 1,
        "action": "gift_small",
        "priority": 1,
        "say": "Một ly Mojito cho {name}!",
        "params": {
          "emoji": "🍹",
          "label": "🍹 Mojito"
        }
      },
      {
        "minCoins": 30,
        "action": "gift_medium",
        "priority": 2,
        "say": "Cảm ơn {name}! Lên sàn nào!",
        "params": {
          "emoji": "🍸",
          "label": "🍸 Cocktail"
        }
      },
      {
        "minCoins": 500,
        "action": "gift_big",
        "priority": 3,
