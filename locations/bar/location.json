        "params": {
          "emoji": "🍾",
          "label": "🍾 Bàn VIP"
        }
      },
      {
        "minCoins": 5000,
        "action": "gift_huge",
        "priority": 4,
        "say": "{name} mời cả quán! Cảm ơn {name}!",
        "params": {
          "emoji": "🥂",
          "label": "🥂 Mời cả quán"
        }
      }
    ],
