# Sao chép file này thành .env rồi điền giá trị. Biến môi trường ghi đè config/config.json.

# Nguồn sự kiện chính: simulator | tiktok
LIVE_SOURCE=simulator
# Username kênh TikTok (không cần @)
TIKTOK_USERNAME=
# API key Euler Stream (để trống = dùng hạn mức miễn phí)
EULER_API_KEY=

# Báo động về điện thoại qua Telegram (tạo bot với @BotFather, lấy chat id qua @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mật khẩu bảng điều khiển (nên đặt nếu mở bảng điều khiển ra ngoài mạng nhà)
DASHBOARD_TOKEN=

# Cổng mở trên máy khi chạy bằng Docker (đổi nếu 3000 đã bị dự án khác dùng)
HOST_PORT=3000
